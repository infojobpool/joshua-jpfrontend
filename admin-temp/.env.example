# Must be absolute (no trailing slash). You may omit /api/v1 if the host has no path —
# the app will append /api/v1 (same as FastAPI on Render or api.jobpool.in).
# Wrong: /api/v1  → relative URL; requests hit the admin site on Vercel, not your API.
# Examples:
# NEXT_PUBLIC_API_BASE_URL=https://api.jobpool.in/api/v1
# NEXT_PUBLIC_API_BASE_URL=https://jobpoolbackend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://api.jobpool.in/api/v1

# --- Verification reminders (optional; use only if FastAPI does NOT implement reminders) ---
# Preferred: implement POST /admin/remind-incomplete-profile/ on the backend (see reminderApi.ts).
# --- Vercel-only fallback (server route /api/reminders/send) ---
# Option A: single webhook that receives JSON { recipients: [...] } and calls your email + WhatsApp APIs
# REMINDER_BATCH_WEBHOOK_URL=https://api.jobpool.in/api/v1/your-endpoint
# REMINDER_BATCH_WEBHOOK_KEY=
#
# Option B: separate POST endpoints per channel (see admin-temp/src/app/api/reminders/send/route.ts)
# REMINDER_EMAIL_API_URL=
# REMINDER_EMAIL_API_KEY=
# REMINDER_WHATSAPP_API_URL=
# REMINDER_WHATSAPP_API_KEY=
# REMINDER_EMAIL_SUBJECT=Complete your JobPool verification
# REMINDER_MESSAGE_TEMPLATE=Hi {{name}}, please complete PAN and Aadhaar in the JobPool app.
